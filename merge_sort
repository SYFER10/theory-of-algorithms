def merge(arr):
    if len(arr) <= 1:
        return arr
    mid = len(arr) // 2
    left = merge(arr[:mid]) 
    right = merge(arr[mid:])
    i = 0
    j = 0
    result = []
    while i < len(left) and j < len(right):
        if left[i] <= right[j]:
            result.append(left[i])
            i += 1
        else:
            result.append(right[j])    
            j += 1
            
    result.extend(left[i:])
    result.extend(right[j:])
    return result

arr = [5, -2, -8, 1, 3, -7]
print(merge(arr))        